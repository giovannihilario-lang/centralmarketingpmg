# Copie este arquivo para ".env" e preencha com os dados reais.
# O .env NUNCA deve ir pro Git (adicione no .gitignore).

# --- Conexão com o SQL Server da rede local ---
SQL_SERVER=NOME-OU-IP-DO-SERVIDOR\\INSTANCIA
SQL_DATABASE=nome_do_banco

# Se o SQL Server "não exige login" (autenticação do Windows), deixe:
SQL_TRUSTED_CONNECTION=true
# Se usar usuário/senha (SQL Authentication), troque para false e preencha:
# SQL_TRUSTED_CONNECTION=false
# SQL_USER=
# SQL_PASSWORD=

SQL_ENCRYPT=false

# --- Porta do servidor local ---
PORT=3001

# --- Variáveis que já existiam no projeto (mantidas) ---
PMG_API_URL=
PMG_USUARIO=
PMG_SENHA=
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Supabase / Módulo Demandas ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública do frontend (Publishable key ou anon key). Nunca use service_role aqui.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protege a execução automática de /api/notificar-demandas
# Gere uma sequência longa e aleatória e cadastre a mesma variável no Vercel.
CRON_SECRET=
VAPID_SUBJECT=mailto:marketing@pmgatacadista.com.br

# Origens extras autorizadas a acessar a API local (separadas por vírgula)
PMG_ALLOWED_ORIGINS=

# Exige sessão válida do PMG Connect para as rotas que consultam o SQL local.
PMG_LOCAL_API_REQUIRE_AUTH=true

# Hosts permitidos no proxy de imagens, separados por vírgula.
# O host de PMG_API_URL é incluído automaticamente quando PMG_API_URL estiver configurada.
PMG_IMAGE_PROXY_HOSTS=
# Performance da API local / Azure SQL
# Em Azure SQL básico, 3 consultas locais simultâneas costuma ser mais estável que uma rajada maior.
PMG_LOCAL_API_CONCURRENCY=3
SQL_POOL_MAX=4

