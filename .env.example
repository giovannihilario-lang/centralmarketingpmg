# Copie este arquivo para ".env" e preencha com os dados reais.
# O .env NUNCA deve ir pro Git (adicione no .gitignore).

# --- Conexão com o SQL Server da rede local ---
SQL_SERVER=NOME-OU-IP-DO-SERVIDOR\\INSTANCIA
SQL_DATABASE=nome_do_banco

# Se o SQL Server "não exige login" (autenticação do Windows), deixe:
SQL_TRUSTED_CONNECTION=true
# Se usar usuário/senha (SQL Authentication), troque para false e preencha:
# SQL_TRUSTED_CONNECTION=false
# SQL_USER=
# SQL_PASSWORD=

SQL_ENCRYPT=false

# --- Porta do servidor local ---
PORT=3001

# --- Variáveis que já existiam no projeto (mantidas) ---
PMG_API_URL=
PMG_USUARIO=
PMG_SENHA=
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Supabase / Módulo Demandas ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Protege a execução automática de /api/notificar-demandas
# Gere uma sequência longa e aleatória e cadastre a mesma variável no Vercel.
CRON_SECRET=
VAPID_SUBJECT=mailto:marketing@pmgatacadista.com.br
