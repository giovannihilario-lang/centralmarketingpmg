{
  "rewrites": [
    {
      "source": "/api/produtos",
      "destination": "/api/produtos"
    },
    {
      "source": "/img-proxy",
      "destination": "/api/img-proxy"
    },
    {
      "source": "/fornecedor/:slug",
      "destination": "/fornecedor/slug.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-produtos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/notificar-demandas",
      "schedule": "5 11 * * *"
    }
  ],
  "functions": {
    "api/campanhas-data.js": {
      "maxDuration": 60
    },
    "api/analisar-documento.js": {
      "maxDuration": 60
    }
  }
}
