{
  "rewrites": [
    {
      "source": "/img-proxy",
      "destination": "/api/img-proxy"
    },
    {
      "source": "/fornecedor/:slug",
      "destination": "/fornecedor/slug.html"
    },
    {
      "source": "/api/wave2/:route*",
      "destination": "/api/wave2?route=:route*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.png|favicon.svg|icons.svg|geo-data.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notificar-demandas",
      "schedule": "5 11 * * *"
    }
  ],
  "functions": {
    "api/campanhas-data.js": {
      "maxDuration": 60
    },
    "api/analisar-documento.js": {
      "maxDuration": 60
    }
  }
}
