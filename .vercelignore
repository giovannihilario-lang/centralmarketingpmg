# Dependências e metadados locais
node_modules
/.git
/.git-corrompido
/.vercel
/.env
/.env.*
!.env.example

# A API SQL continua sendo apenas local. O server.js permanece no deploy como
# entrypoint Express reconhecido automaticamente pela Vercel.
/local-api

# Fontes, ferramentas e arquivos de manutenção não participam do runtime.
/api-backup
/api-legacy
/fontes
/sql
/scripts
/data
*.md
*.txt
